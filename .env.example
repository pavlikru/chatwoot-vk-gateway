# ─── Gateway ──────────────────────────────────────────────────────────────────
NODE_ENV=production
# HTTP port the gateway listens on
PORT=3000
# Public HTTPS base URL of the gateway (required for VK_MODE=callback).
# Example: https://vk-gw.example.com
PUBLIC_URL=
# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Max attachment size (MB) the gateway will download/relay
MAX_ATTACHMENT_MB=50

# ─── VK ───────────────────────────────────────────────────────────────────────
# How the gateway receives VK events: "longpoll" (no public URL, good for dev)
# or "callback" (VK posts to ${PUBLIC_URL}/vk/callback, good for production).
VK_MODE=longpoll
# Community (group) access token with the "messages" permission.
VK_TOKEN=
# Numeric community (group) id. Required for longpoll mode.
VK_GROUP_ID=
# VK API version.
VK_API_VERSION=5.199
# Callback mode only: the confirmation string from the community Callback API settings.
VK_CONFIRMATION=
# Callback mode only: the secret key configured in the community Callback API settings.
VK_CALLBACK_SECRET=

# ─── Chatwoot ─────────────────────────────────────────────────────────────────
# Base URL of your Chatwoot installation, no trailing slash. Example: https://app.chatwoot.com
CHATWOOT_URL=
# Numeric account id (see the URL after /accounts/ in the Chatwoot UI).
CHATWOOT_ACCOUNT_ID=
# Application API access token (Profile settings → Access Token), admin/agent scope.
CHATWOOT_TOKEN=
# Numeric id of the API inbox created for VK.
CHATWOOT_INBOX_ID=
# Optional: shared secret to verify Chatwoot webhook HMAC signatures.
CHATWOOT_WEBHOOK_SECRET=

# ─── Optional ─────────────────────────────────────────────────────────────────
# Redis URL for the dedup cache. Leave empty to use the in-memory cache.
REDIS_URL=
